# Copier ce fichier en .env et remplacer les valeurs factices.
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL
DATABASE_URL=postgres://fieldops:changeme@localhost:5432/fieldops
POSTGRES_PASSWORD=changeme

# Authentification
JWT_SECRET=changeme

# Service de cartographie (géocodage des adresses d'intervention)
MAP_API_URL=https://maps.example.invalid/v1
MAP_API_KEY=changeme

# Service d'e-mail transactionnel (comptes rendus d'intervention)
MAIL_API_URL=https://mail.example.invalid/v3
MAIL_API_KEY=changeme
MAIL_FROM=no-reply@example.invalid

# Service de paiement (acomptes clients)
PAYMENT_API_URL=https://payments.example.invalid/v1
PAYMENT_API_KEY=changeme
PAYMENT_WEBHOOK_SECRET=changeme

# Données de démonstration
SEED_PASSWORD=changeme
