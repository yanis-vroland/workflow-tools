{
  "name": "fieldops",
  "version": "1.2.0",
  "private": true,
  "description": "Gestion des interventions des techniciens terrain (API et back-office web).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^17.0.70",
    "@types/react-dom": "^17.0.23",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.54.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.4",
    "vitest": "^1.0.1"
  }
}
